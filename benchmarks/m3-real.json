{
  "id": "m3-real",
  "name": "M3 Real Task Benchmark",
  "description": "First real benchmark suite for Verdikt observability and reliability. Covers small baseline, medium multi-file, large feature/refactor, negative (impossible/cheating), and regression tasks.",

  "defaults": {
    "maxIterations": 3,
    "budgetUsd": 5,
    "worktree": true,
    "integrity": true,
    "autoApply": false
  },

  "tasks": [
    {
      "id": "s1-reverse",
      "taskFile": "tasks/benchmark/s1-reverse.json",
      "category": "small",
      "expectedOutcome": "passed",
      "tags": ["baseline", "bugfix"]
    },
