{
  "name": "verdikt",
  "version": "0.1.0",
  "packageManager": "pnpm@11.7.0",
  "type": "module",
  "description": "Autonomous iterative coder — Executor + Verifier dual-role loop with objective judge verdicts",
  "bin": {
    "verdikt": "./dist/index.js"
  },
  "files": [
    "dist/",
    "apps/ui/",
    "assets/demo-project/",
    "scripts/",
    "README.md",
    "USAGE_GUIDE.md",
    "PRODUCT.md",
    "DESIGN.md",
    ".env.example"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "vitest run --exclude src/claude/processTree.test.ts --exclude src/workspace/warm.test.ts --exclude src/workspace/worktree.integration.test.ts",
    "test:integration": "vitest run src/claude/processTree.test.ts src/workspace/warm.test.ts src/workspace/worktree.integration.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "quality": "pnpm lint && pnpm build && pnpm package:check && pnpm test && pnpm security:scan && pnpm stress:ci && pnpm vscode:compile",
    "verdikt": "tsx src/index.ts",
    "prepack": "pnpm build",
    "package:check": "tsx src/release/packageCheck.ts",
    "security:scan": "tsx src/security/scan.ts",
    "stress": "tsx src/index.ts stress",
    "stress:ci": "tsx src/index.ts stress --iterations=5 --concurrency=2 --http-requests=50 --http-concurrency=10 --max-p95-ms=2000",
    "vscode:compile": "pnpm --dir apps/vscode compile",
    "release:connected": "tsx src/release/connectedTask.ts",
    "release:check": "pnpm quality && pnpm release:connected",
    "app": "pnpm build && node dist/index.js app",
    "app:no-open": "pnpm build && node dist/index.js app --no-open",
    "demo": "tsx src/index.ts run --task examples/demo.task.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.2.7",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
