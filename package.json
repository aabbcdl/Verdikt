{
  "name": "verdikt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Autonomous iterative coder — Executor + Verifier dual-role loop with objective judge verdicts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "verdikt": "tsx src/index.ts",
    "demo": "tsx src/index.ts run --task examples/demo.task.json"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
