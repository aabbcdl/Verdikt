# Verdikt environment configuration
# Export these variables in your shell, or load them with your preferred .env tool.

# The Web workbench can save these settings for you. Environment variables remain
# available for CLI-only usage and take effect when no saved workbench setting exists.

# Claude Code model
VERDIKT_MODEL=sonnet

# Anthropic-compatible API or gateway. Claude Code is still required.
# A plain OpenAI-compatible endpoint does not work without an Anthropic compatibility layer.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=replace-me
# Use this instead of ANTHROPIC_API_KEY when the gateway expects Bearer authentication.
# ANTHROPIC_AUTH_TOKEN=replace-me

# Long-running defaults
# VERDIKT_MAX_ITERATIONS=5
# VERDIKT_SOFT_TIMEOUT_MS=120000
# VERDIKT_TIMEOUT_MS=300000
# VERDIKT_ABSOLUTE_TIMEOUT_MS=600000
# VERDIKT_MAX_RETRIES=2
# VERDIKT_STATE_DIR=.verdikt
# VERDIKT_VERBOSE=false

# Launcher script options for scripts/start-verdikt-app.sh
# VERDIKT_PORT=3849
# VERDIKT_NO_OPEN=1
# VERDIKT_NO_RESTART=0
# VERDIKT_RESTART_DELAY_SECONDS=2
# VERDIKT_MAX_RESTARTS=0
# VERDIKT_SKIP_BUILD=0
