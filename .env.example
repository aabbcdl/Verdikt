# Verdikt environment configuration
# Copy to .env and fill in your values

# Claude Code model (passed as --model to claude CLI)
VERDIKT_MODEL=mimo-v2.5-pro

# Claude Code API configuration (read by claude CLI automatically)
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides
# VERDIKT_MAX_ITERATIONS=5
# VERDIKT_TIMEOUT_MS=300000
# VERDIKT_STATE_DIR=.verdikt
