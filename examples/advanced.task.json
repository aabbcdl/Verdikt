{
  "id": "advanced-safe-workflow",
  "goal": "Review the Verdikt project and make one small, well-tested improvement without changing public behavior.",
  "repoPath": "..",
  "acceptance": {
    "steps": [
      {
        "id": "build",
        "command": "pnpm",
        "args": ["build"]
      },
      {
        "id": "test",
        "command": "pnpm",
        "args": ["vitest", "run", "src/usage.test.ts"]
      }
    ]
  },
  "maxIterations": 4,
  "maxBudgetUsd": 5,
  "integrity": {
    "allowTestChanges": false
  },
  "semantic": {
    "maxRisk": "low"
  },
  "planning": {
    "mode": "required",
    "requireApproval": true
  },
  "hooks": [
    {
      "event": "before_run",
      "script": "examples/hooks/allow.cjs",
      "timeoutMs": 15000,
      "failureMode": "block"
    },
    {
      "event": "after_judges",
      "script": "examples/hooks/allow.cjs",
      "timeoutMs": 15000,
      "failureMode": "warn"
    }
  ]
}
