{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedVariables": "warn"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "coverage",
      ".verdikt",
      "apps/vscode",
      "tasks/benchmark/fixtures",
      "examples/demo-dogfood",
      "examples/demo-cascade",
      "examples/demo-cascade-deep",
      "examples/demo-multi-round"
    ]
  }
}
